{
  "name": "sequencer",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --recursive --if-present build",
    "test": "vitest run",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:web:coverage": "vitest run --config vitest.web.config.ts --coverage",
    "test:system": "vitest run --config vitest.system.config.ts",
    "test:all": "pnpm test && pnpm test:system",
    "test:watch": "vitest",
    "lint": "biome check --write .",
    "lint:ci": "biome check .",
    "seq": "tsx scripts/seq/index.ts",
    "db:migrate:local": "wrangler d1 migrations apply sequencer-db --local --config apps/api/wrangler.toml",
    "seed:dev": "wrangler d1 execute sequencer-db --local --config apps/api/wrangler.toml --file scripts/dev/seed-local-contacts.sql",
    "screenshots": "node scripts/dev/capture-screenshots.mjs",
    "setup:cf": "node scripts/setup-cloudflare.mjs",
    "deploy:prod": "node scripts/deploy-production.mjs",
    "deploy:prod:dry-run": "node scripts/deploy-production.mjs --dry-run",
    "deploy:prod:migrate": "node scripts/deploy-production.mjs --migrate",
    "apply:prod-config": "node scripts/apply-production-config.mjs",
    "apply:prod-config:dry-run": "node scripts/apply-production-config.mjs --dry-run",
    "apply:prod-config:missing": "node scripts/apply-production-config.mjs --secrets-file dist/missing-production-secrets.template.json",
    "apply:prod-config:missing:dry-run": "node scripts/apply-production-config.mjs --dry-run --secrets-file dist/missing-production-secrets.template.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/vitest-pool-workers": "0.8.69",
    "@cloudflare/workers-types": "^4.20250522.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.14.0"
  }
}
