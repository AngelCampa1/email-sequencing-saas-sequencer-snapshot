{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "@sequencer/db": ["../../packages/db/src/index.ts"],
      "@sequencer/shared": ["../../packages/shared/src/index.ts"],
      "@sequencer/emails": ["../../packages/emails/src/index.ts"],
      "@sequencer/emails/templates/*": ["../../packages/emails/src/templates/*.tsx"]
    }
  },
  "include": ["src/**/*"]
}
