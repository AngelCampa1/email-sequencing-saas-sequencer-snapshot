{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "../..",
    "paths": {
      "@sequencer/db": ["packages/db/src/index.ts"],
      "@sequencer/emails": ["packages/emails/src/index.ts"],
      "@sequencer/sdk": ["packages/sdk/src/index.ts"],
      "@sequencer/shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
