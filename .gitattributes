# Normalize line endings to LF in the repository and on checkout.
#
# Biome's formatter expects LF. Without this, a Windows checkout with
# core.autocrlf=true produces CRLF working files and `pnpm lint:ci` reports a
# format error on essentially every file, even though the committed blobs are LF.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
